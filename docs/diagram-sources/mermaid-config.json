{
  "theme": "base",
  "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif",
  "themeVariables": {
    "background": "#07111f",
    "primaryColor": "#10243a",
    "primaryTextColor": "#e8f6ff",
    "primaryBorderColor": "#38bdf8",
    "secondaryColor": "#0d2d38",
    "secondaryTextColor": "#e8f6ff",
    "secondaryBorderColor": "#2dd4bf",
    "tertiaryColor": "#172036",
    "tertiaryTextColor": "#e8f6ff",
    "tertiaryBorderColor": "#818cf8",
    "lineColor": "#7dd3fc",
    "textColor": "#e8f6ff",
    "mainBkg": "#10243a",
    "secondBkg": "#0d2d38",
    "border1": "#38bdf8",
    "border2": "#2dd4bf",
    "noteBkgColor": "#172036",
    "noteTextColor": "#dbeafe",
    "noteBorderColor": "#818cf8",
    "actorBkg": "#10243a",
    "actorBorder": "#38bdf8",
    "actorTextColor": "#e8f6ff",
    "actorLineColor": "#475569",
    "signalColor": "#7dd3fc",
    "signalTextColor": "#e8f6ff",
    "labelBoxBkgColor": "#172036",
    "labelBoxBorderColor": "#818cf8",
    "labelTextColor": "#e8f6ff",
    "loopTextColor": "#e8f6ff",
    "activationBkgColor": "#164e63",
    "activationBorderColor": "#22d3ee",
    "classText": "#e8f6ff"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "nodeSpacing": 55,
    "rankSpacing": 70,
    "padding": 18
  },
  "sequence": {
    "diagramMarginX": 40,
    "diagramMarginY": 30,
    "actorMargin": 70,
    "messageMargin": 42,
    "noteMargin": 18,
    "mirrorActors": false,
    "useMaxWidth": true
  }
}
