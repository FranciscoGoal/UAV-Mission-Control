flowchart TB
    subgraph TransportLane["INBOUND STOMP FLOW"]
        direction LR
        Client["STOMP client"] --> WS["WebSocket<br/>/ws"]
        WS --> Routing["STOMP routing<br/>/app · /topic · /queue · /user"]
        Routing --> Controller["TelemetryController<br/>/app/telemetry"]
    end

    subgraph UavLane["IMPLEMENTED UAV FLOW"]
        direction LR
        Caller["Internal Java caller"] --> Service["UavService"]
        Controller --> Service
        Service --> Uav["UAV domain<br/>Uav · Position · UavStatus · Telemetry"]
        Service --> UavPort["UavRepository"]
        Service --> TelemetryPort["TelemetryRepository"]
        UavStore["In-memory UAV store"] -. "implements" .-> UavPort
        TelemetryStore["In-memory telemetry history"] -. "implements" .-> TelemetryPort
    end

    subgraph CommandLane["PARTIAL COMMAND FLOW"]
        direction LR
        Commands["Command domain<br/>4 command types"] --> CommandPort["CommandRepository"]
        CommandCaller["Internal Java caller"] --> CommandService["CommandService<br/>create PENDING execution"]
        CommandService --> CommandPort
        CommandService --> Executions["CommandExecution<br/>latest status snapshot"]
        Executions --> ExecutionPort["CommandExecutionRepository"]
        CommandStore["In-memory command store"] -. "implements" .-> CommandPort
        ExecutionStore["In-memory execution store"] -. "implements" .-> ExecutionPort
    end

    TransportLane ~~~ UavLane
    UavLane ~~~ CommandLane

