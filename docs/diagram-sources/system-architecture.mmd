    classDef domain fill:#0d2d38,stroke:#2dd4bf,stroke-width:2px,color:#e8f6ff;
    classDef storage fill:#172036,stroke:#818cf8,stroke-width:2px,color:#e8f6ff;
    class Client,WS,Routing,Controller,Caller,Service,CommandCaller,CommandService transport;
    class Uav,Commands,Executions,UavPort,TelemetryPort,CommandPort,ExecutionPort domain;
    class UavStore,TelemetryStore,CommandStore,ExecutionStore storage;
